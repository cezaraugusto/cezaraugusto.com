---
permalink: feed.xml
excludeFromSitemap: true
metadata:
  title: Cezar Augusto
  url: https://cezaraugusto.com/
  author:
    name: Cezar Augusto
    uri: https://cezaraugusto.com/about/
  feed:
    filename: feed.xml
    path: feed/feed.xml
    url: https://cezaraugusto.com/feed.xml
    id: https://cezaraugusto.com/
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ metadata.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ metadata.feed.url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ metadata.url }}" rel="alternate" type="text/html"/>
  <updated>{{ collections.posts | newest_update | dateToRfc3339 }}</updated>
  <id>{{ metadata.feed.id }}</id>
  <author>
    <name>{{ metadata.author.name }}</name>
    <uri>{{ metadata.author.uri }}</uri>
  </author>
  {%- for post in collections.posts %}
  {% set absolutePostUrl %}{{ post.url | url | absoluteUrl(metadata.url) }}{% endset %}
  {%- set postSummary = post.data.description or post.data.summary %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.data.link or absolutePostUrl }}" rel="alternate" type="text/html"/>
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ (post | lastmod) | dateToRfc3339 }}</updated>
    <id>{{ absolutePostUrl }}</id>
    {%- if postSummary %}
    <summary>{{ postSummary | markdownify_inline | strip_html | trim }}</summary>
    {%- endif %}
    <content type="html">{{ post.templateContent | htmlToAbsoluteUrls(absolutePostUrl) }}</content>
  </entry>
  {%- endfor %}
</feed>
