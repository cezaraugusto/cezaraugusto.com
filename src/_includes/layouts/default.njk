    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BGCEW25QFJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-BGCEW25QFJ');
    </script>
    {%- endif %}
  </head>
  <body>
    <a href="#main-content">Skip to content</a>
    <header>
      {%- set avatar %}<img src="{{ site.avatar.src }}" alt="" width="{{ site.avatar.width }}" height="{{ site.avatar.height }}" eleventy:widths="96,144" sizes="48px" loading="eager">{% endset %}
      {%- set nameLabel = site.headline if site.headline == "Cezar Augusto" else site.headline + ": Cezar Augusto" %}
      {% if page.url == "/" %}<h1{% if nameLabel != site.headline %} aria-label="{{ nameLabel }}"{% endif %}>{{ avatar | safe }} {{ site.headline }}</h1>{% else %}<p><a href="/" rel="home" aria-label="{{ nameLabel }}, home">{{ avatar | safe }} {{ site.headline }}</a></p>{% endif %}
      <p>{{ site.intro | markdownify_inline | link_icons(site.introIcons) | replace('<a href="/about/">', '<a href="/about/" rel="author">') | safe }}</p>
    </header>
    {% block main %}{% endblock %}
    {% include "components/footer.njk" %}
    <script>
      {% set corejs %}{% include "js/app.js" %}{% endset %}
      {{ corejs | safe }}
    </script>
    {%- set jsonLd = metaImage | structured_data %}
    {%- if jsonLd %}
    <script type="application/ld+json">
      {{ jsonLd | safe }}
    </script>
    {%- endif %}
  </body>
</html>