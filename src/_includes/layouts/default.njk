<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    {%- set metaTitle %}{% if page.url == "/" %}{{ site.homeTitle }}{% elif title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}{% endset %}
    {%- set metaDescription = (description or summary or site.description) | markdownify_inline | strip_html | trim %}
    {%- set cardTitle = title if page.url != "/" else site.title %}
    {%- set cardKicker = "Blog post" if layout == "layouts/post" else ("Browser extensions, Extension.js and extension.dev" if page.url == "/" else "cezaraugusto.com") %}
    {%- set metaImage = site.url + (page.url | og_card(cardTitle, cardKicker)) %}
    {%- set metaImageAlt %}Share card with the heading "{{ cardTitle }}" under the label "{{ cardKicker }}", and Cezar Augusto's avatar, name and cezaraugusto.com at the bottom{% endset %}
    {%- set isArticle = layout == "layouts/post" %}
    {%- set metaUrl = site.url + (page.url | permalink) %}
    <title>{{ metaTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="author" content="Cezar Augusto">
    <meta name="application-name" content="{{ site.title }}">
    <meta name="theme-color" content="#f9f9f9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#222222" media="(prefers-color-scheme: dark)">
    {%- if not noindex %}
    <link rel="canonical" href="{{ metaUrl }}">
    {%- endif %}
    <!-- open graph -->
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    {%- if not noindex %}
    <meta property="og:url" content="{{ metaUrl }}">
    {%- endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:image" content="{{ metaImage }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="{{ ogCardSize.width }}">
    <meta property="og:image:height" content="{{ ogCardSize.height }}">
    <meta property="og:image:alt" content="{{ metaImageAlt }}">
    <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
    <meta property="og:locale" content="{{ site.language }}">
    {%- if isArticle and date %}
    <meta property="article:published_time" content="{{ page.date | html_date_string }}">
    <meta property="article:modified_time" content="{{ (updated or page.date) | html_date_string }}">
    <meta property="article:author" content="{{ site.url }}/about/">
    {%- endif %}
    <!-- x -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:site" content="@{{ site.twitter }}">
    <meta name="twitter:image" content="{{ metaImage }}">
    <meta name="twitter:image:alt" content="{{ metaImageAlt }}">
    <meta name="twitter:creator" content="@{{ site.twitter }}">
    <!-- icons -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/static/icons/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/static/icons/favicon-16.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <!-- robots -->
    <meta name="robots" content="{% if noindex %}noindex, follow{% else %}{% GenerateRobotsTXTRules %}{% endif %}">
    <!-- social media -->
    <link rel="me" href="https://github.com/cezaraugusto" type="text/html">
    <link rel="me" href="https://x.com/cezaraugusto" type="text/html">
    <link rel="me" href="https://www.quora.com/profile/Cezar-Augusto-1" type="text/html">
    <link rel="me" href="{{ site.profiles.linkedin }}" type="text/html">
    <link rel="me" href="{{ site.profiles.substack }}" type="text/html">
    <link rel="me" href="{{ site.profiles.npm }}" type="text/html">
    <!-- rss -->
    <link rel="alternate" href="/feed.xml" type="application/atom+xml" title="Cezar Augusto posts">
    <!-- license -->
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/">
    <!-- website ownership -->
    <meta name="google-site-verification" content="1fnKj4QPudeZ0eb7vkdW8zbc1PwwMocSKpQRGcxREgY">
    <meta name="msvalidate.01" content="E718A8AA0D4E3ED605BFF1BA1C0E46A7">
    <meta name="yandex-verification" content="0dd50ab9279c1413">
    <link rel="preload" href="/static/fonts/manrope-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>

    <style>
