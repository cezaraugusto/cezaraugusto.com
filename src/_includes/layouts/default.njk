/* Sakura.css v1.5.1
 * ================
 * Minimal css theme.
 * Project: https://github.com/oxalorg/sakura/
 */
/* Body */
html {
  font-size: 62.5%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
}

body {
  font-size: 1.8rem;
  line-height: 1.618;
  max-width: 38em;
  margin: auto;
  color: #4a4a4a;
  background-color: #f9f9f9;
  padding: 1.3rem;
}

@media (max-width: 684px) {
  body {
    font-size: 1.7rem;
  }
}
h1, h2, h3 {
  line-height: 1.25;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 700;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
  overflow-wrap: break-word;
  word-wrap: break-word;
  -ms-word-break: break-all;
  word-break: break-word;
}

h1 {
  font-size: 2.4rem;
}

h2 {
  font-size: 2rem;
}

h3 {
  font-size: 1.8rem;
}

p {
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

small {
  font-size: 75%;
}

a {
  text-decoration: none;
  color: #0065e6;
}
a:visited {
  color: #0065e6;
}
a:hover {
  color: #004fb4;
  border-bottom: 2px solid #4a4a4a;
}

ul {
  padding-left: 1.4em;
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

li {
  margin-bottom: 0.4em;
}

blockquote {
  margin-left: 0px;
  margin-right: 0px;
  padding-left: 1em;
  padding-top: 0.8em;
  padding-bottom: 0.8em;
  padding-right: 0.8em;
  border-left: 5px solid #0065e6;
  margin-bottom: 2.5rem;
  background-color: #f1f1f1;
}

blockquote p {
  margin-bottom: 0;
}

img, video {
  height: auto;
  max-width: 100%;
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

/* Pre and Code */
pre {
  background-color: #f1f1f1;
  display: block;
  padding: 1em;
  overflow-x: auto;
  margin-top: 0px;
  margin-bottom: 2.5rem;
  font-size: 0.9em;
}

code {
  font-size: 0.9em;
  padding: 0 0.5em;
  background-color: #f1f1f1;
  white-space: pre-wrap;
}

pre > code {
  padding: 0;
  background-color: transparent;
  white-space: pre;
  font-size: 1em;
}

/* Buttons */
button {
  display: inline-block;
  padding: 5px 10px;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  background-color: #0065e6;
  color: #f9f9f9;
  border-radius: 1px;
  border: 1px solid #0065e6;
  cursor: pointer;
  box-sizing: border-box;
}

button:hover {
  background-color: #004fb4;
  color: #f9f9f9;
  outline: 0;
}

button:focus-visible {
  outline-style: solid;
  outline-width: 2px;
}

/* Titles and descriptions: Manrope from @fontsource/manrope 5.3.0 (SIL OFL 1.1) */
@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-display: swap;
  font-weight: 500;
  src: url(/static/fonts/manrope-latin-500-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-display: swap;
  font-weight: 700;
  src: url(/static/fonts/manrope-latin-700-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

h1, h2 {
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 700;
  letter-spacing: -0.02em;
}

body > header > :first-child {
  position: relative;
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-size: 2.8rem;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.035em;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
}

body > header > :first-child a {
  color: inherit;
}

body > header > :first-child + p,
main > h1 + p,
article > header + p {
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 500;
}

/* Site arrangement */
main section ol,
main > ol {
  list-style: none;
  padding-left: 0;
}

body > footer {
  margin-top: 6rem;
}

body > header > :first-child img {
  display: block;
  width: 4.8rem;
  height: 4.8rem;
  border-radius: 50%;
  margin: 0 0 1.5rem;
}

@media (min-width: 53em) and (pointer: fine), (min-width: 60em) {
  body > header > :first-child img {
    position: absolute;
    top: 50%;
    right: 100%;
    margin: -2.4rem 1.6rem 0 0;
  }
}

body > header > :first-child + p img,
article > footer p > a img {
  display: inline;
  width: 1em;
  height: 1em;
  margin: 0 0.3em 0 0;
  vertical-align: -0.15em;
}
/* Accessibility */
body > a[href="#main-content"] {
  position: absolute;
  left: -9999px;
  top: 0;
}

body > a[href="#main-content"]:focus {
  left: 13px;
  top: 13px;
  z-index: 1;
  padding: 0.5em 1em;
  background-color: #f9f9f9;
}

a {
  text-decoration: underline;
  text-decoration-color: #0065e6;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.15em;
}

a:hover {
  border-bottom: 0;
  text-decoration-color: #004fb4;
  text-decoration-thickness: 2px;
}

:is(h1, h2, h3, h4, h5, h6) > a:only-child,
body > header > :first-child a {
  text-decoration: none;
}

:focus-visible {
  outline: 2px solid #0065e6;
  outline-offset: 2px;
}

[tabindex="-1"]:focus {
  outline: 0;
}

iframe {
  max-width: 100%;
  border: 0;
}

iframe:not([width]) {
  width: 100%;
}

dialog h2 {
  font-size: 2rem;
}

/* Post media: centered images, captions and X embeds */
article figure {
  margin-left: 0;
  margin-right: 0;
  text-align: center;
}

article figure img,
article figure video {
  display: block;
  margin-left: auto;
  margin-right: auto;
}

article figcaption {
  text-align: center;
}

article blockquote.twitter-tweet,
article div.twitter-tweet {
  max-width: 550px;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

/* Post footer lists */
article > footer ol {
  list-style: none;
  padding-left: 0;
}

/* Site footer: one row of links, bullets drawn in CSS and kept off line starts */
body > footer nav ul {
  font-size: 0.9em;
  list-style: none;
  padding-left: 0;
  margin-bottom: 1.5rem;
}

body > footer nav li {
  display: inline;
  white-space: nowrap;
}

body > footer nav li:not(:last-child)::after {
  content: "\2022";
  content: "\2022" / "";
  margin-left: 0.3em;
}

body > footer p {
  margin-bottom: 1rem;
}

/* Apple HIG: color scheme, safe areas, motion, contrast and hit targets */
html {
  color-scheme: light dark;
  accent-color: #0065e6;
}

body {
  padding-top: max(1.3rem, env(safe-area-inset-top));
  padding-right: max(1.3rem, env(safe-area-inset-right));
  padding-bottom: max(1.3rem, env(safe-area-inset-bottom));
  padding-left: max(1.3rem, env(safe-area-inset-left));
}

/* Dark palette from sakura-dark.css v1.5.1; accent is the Extension.js docs
   theme (docs.json colors: primary #0065e6, light #60a5fa) */
@media (prefers-color-scheme: dark) {
  html {
    accent-color: #60a5fa;
  }
  body {
    color: #c9c9c9;
    background-color: #222222;
  }
  a, a:visited {
    color: #60a5fa;
    text-decoration-color: #60a5fa;
  }
  a:hover {
    color: #93c5fd;
    text-decoration-color: #93c5fd;
  }
  blockquote {
    border-left-color: #60a5fa;
    background-color: #4a4a4a;
  }
  blockquote a, blockquote a:visited {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }
  a code {
    color: #ffffff;
  }
  pre, code {
    background-color: #4a4a4a;
  }
  pre, pre span {
    color: var(--shiki-dark) !important;
  }
  button {
    background-color: #60a5fa;
    color: #222222;
    border-color: #60a5fa;
  }
  button:hover {
    background-color: #93c5fd;
    border-color: #93c5fd;
    color: #222222;
  }
  :focus-visible {
    outline-color: #60a5fa;
  }
  body > a[href="#main-content"]:focus {
    background-color: #222222;
  }
  body > header > :first-child + p img[src*="extension-dev"],
  article > footer p > a img[src*="/x-"] {
    border-radius: 0.2em;
    box-shadow: 0 0 0 1px #4a4a4a;
  }
}

@media (prefers-contrast: more) {
  body {
    color: #222222;
  }
  a {
    color: #004fb4;
    text-decoration-thickness: 2px;
  }
  button {
    background-color: #004fb4;
    border-color: #004fb4;
  }
  :focus-visible {
    outline-width: 3px;
  }
}

@media (prefers-contrast: more) and (prefers-color-scheme: dark) {
  body {
    color: #ffffff;
  }
  a, a:visited {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }
  button {
    background-color: #ffffff;
    border-color: #ffffff;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

@media (pointer: coarse) {
  button {
    min-height: 4.4rem;
    min-width: 4.4rem;
  }
  main li > a:first-child {
    padding-block: 1.2rem;
  }
  main li {
    margin-bottom: 0.8em;
  }
  body > footer nav a,
  article > header nav a,
  h2 a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    min-width: 4.4rem;
  }
}
    </style>
