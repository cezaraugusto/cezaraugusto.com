/* Sakura.css v1.5.1
 * ================
 * Minimal css theme.
 * Project: https://github.com/oxalorg/sakura/
 */
/* Tokens: long-form prose colors, redefined for dark mode below */
:root {
  --prose-strong: #1d1d1f;
  --prose-muted: #6b6b70;
  --prose-hairline: #e2e2e5;
  --prose-rule: #cfcfd4;
  --prose-tint: #f1f1f3;
  --prose-code: #f1f1f1;
  --prose-raised: #ffffff;
  --prose-mark: #fff1a8;
  --prose-mark-text: #1d1d1f;
  --prose-ins: #e3f4e6;
  --prose-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
}

/* Body */
html {
  font-size: 62.5%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
}

body {
  font-size: 1.8rem;
  line-height: 1.618;
  max-width: 38em;
  margin: auto;
  color: #4a4a4a;
  background-color: #f9f9f9;
  padding: 1.3rem;
}

@media (max-width: 684px) {
  body {
    font-size: 1.7rem;
  }
}
h1, h2, h3 {
  line-height: 1.25;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 700;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
  overflow-wrap: break-word;
  word-wrap: break-word;
  -ms-word-break: break-all;
  word-break: break-word;
}

h1 {
  font-size: 2.4rem;
}

h2 {
  font-size: 2rem;
}

h3 {
  font-size: 1.8rem;
}

p {
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

small {
  font-size: 75%;
}

a {
  text-decoration: none;
  color: #0065e6;
}
a:visited {
  color: #0065e6;
}
a:hover {
  color: #004fb4;
  border-bottom: 2px solid #4a4a4a;
}

ul {
  padding-left: 1.4em;
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

li {
  margin-bottom: 0.4em;
}

blockquote {
  margin: 0 0 2.5rem;
  padding: 0;
}

blockquote p {
  margin-bottom: 0;
}

img, video {
  height: auto;
  max-width: 100%;
  margin-top: 0px;
  margin-bottom: 2.5rem;
}

/* Pre and Code */
code, kbd, pre, samp {
  font-family: var(--prose-mono);
}

pre {
  background-color: var(--prose-code);
  display: block;
  padding: 1.6rem 2rem;
  overflow-x: auto;
  margin-top: 0px;
  margin-bottom: 3rem;
  border-radius: 1.2rem;
  font-size: 1.45rem;
  line-height: 1.65;
  tab-size: 2;
}

code {
  font-size: 0.84em;
  padding: 0.12em 0.4em;
  border-radius: 0.4rem;
  background-color: var(--prose-tint);
  white-space: pre-wrap;
  overflow-wrap: break-word;
}

pre > code {
  padding: 0;
  border-radius: 0;
  background-color: transparent;
  white-space: pre;
  overflow-wrap: normal;
  font-size: 1em;
}

/* Buttons */
button {
  display: inline-block;
  padding: 5px 10px;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  background-color: #0065e6;
  color: #f9f9f9;
  border-radius: 1px;
  border: 1px solid #0065e6;
  cursor: pointer;
  box-sizing: border-box;
}

button:hover {
  background-color: #004fb4;
  color: #f9f9f9;
  outline: 0;
}

button:focus-visible {
  outline-style: solid;
  outline-width: 2px;
}

/* Titles and descriptions: Manrope from @fontsource/manrope 5.3.0 (SIL OFL 1.1) */
@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-display: swap;
  font-weight: 500;
  src: url(/static/fonts/manrope-latin-500-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: "Manrope";
  font-style: normal;
  font-display: swap;
  font-weight: 700;
  src: url(/static/fonts/manrope-latin-700-normal.woff2) format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

h1, h2 {
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 700;
  letter-spacing: -0.02em;
}

body > header > :first-child {
  position: relative;
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-size: 2.8rem;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: -0.035em;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
}

body > header > :first-child a {
  color: inherit;
}

body > header > :first-child + p,
main > h1 + p,
article > header + p {
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 500;
}

/* Site arrangement */
main section ol,
main > ol {
  list-style: none;
  padding-left: 0;
}

body > footer {
  margin-top: 6rem;
}

body > header > :first-child img {
  display: block;
  width: 4.8rem;
  height: 4.8rem;
  border-radius: 50%;
  margin: 0 0 1.5rem;
}

@media (min-width: 53em) and (pointer: fine), (min-width: 60em) {
  body > header > :first-child img {
    position: absolute;
    top: 50%;
    right: 100%;
    margin: -2.4rem 1.6rem 0 0;
  }
}

body > header > :first-child + p img,
article > footer p > a img,
main > ol > li > a img,
main > section > ol > li > a img {
  display: inline;
  width: 1em;
  height: 1em;
  margin: 0 0.3em 0 0;
  vertical-align: -0.15em;
}
a.badge,
a.badge:visited {
  display: inline-flex;
  align-items: center;
  gap: 0.35em;
  position: relative;
  margin-right: 0.4em;
  padding: 0 0.5em;
  border-radius: 0.3em;
  font-size: 75%;
  font-variant-numeric: tabular-nums;
  line-height: 1.8;
  white-space: nowrap;
  vertical-align: 0.15em;
  color: #4a4a4a;
  background-color: #f1f1f1;
  text-decoration: none;
}

a.badge:hover {
  color: #004fb4;
  border-bottom: 0;
}

/* Accessibility */
body > a[href="#main-content"] {
  position: absolute;
  left: -9999px;
  top: 0;
}

body > a[href="#main-content"]:focus {
  left: 13px;
  top: 13px;
  z-index: 1;
  padding: 0.5em 1em;
  background-color: #f9f9f9;
}

a {
  text-decoration: underline;
  text-decoration-color: #0065e6;
  text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  text-decoration-thickness: 1px;
  text-decoration-skip-ink: auto;
  text-underline-offset: 0.22em;
  transition: color 0.15s ease, text-decoration-color 0.15s ease;
}

a:hover {
  border-bottom: 0;
  text-decoration-color: currentColor;
  text-decoration-thickness: 2px;
}

:is(h1, h2, h3, h4, h5, h6) > a:only-child,
body > header > :first-child a {
  text-decoration: none;
}

:focus-visible {
  outline: 2px solid #0065e6;
  outline-offset: 2px;
}

[tabindex="-1"]:focus {
  outline: 0;
}

iframe {
  max-width: 100%;
  border: 0;
}

iframe:not([width]) {
  width: 100%;
}

dialog h2 {
  font-size: 2rem;
}

/* Post media: centered images, captions and X embeds */
article figure {
  margin-left: 0;
  margin-right: 0;
  text-align: center;
}

article figure img,
article figure video {
  display: block;
  margin-left: auto;
  margin-right: auto;
}

article figcaption {
  text-align: center;
}

main p:has(> :is(img, picture, video):only-child) {
  max-width: none;
}

main p > img:only-child,
main p > picture:only-child > img,
main p > video:only-child {
  display: block;
  margin-left: auto;
  margin-right: auto;
}

article blockquote.twitter-tweet,
article div.twitter-tweet {
  max-width: 550px;
  margin-left: auto;
  margin-right: auto;
  box-sizing: border-box;
}

/* Post footer lists */
article > footer ol {
  list-style: none;
  padding-left: 0;
}

/* Long-form prose: post and page bodies */
article > p,
article > ul,
article > ol {
  line-height: 1.65;
}

article > :is(p, ul, ol, dl) {
  max-width: 63rem;
}

article :is(h2, h3, h4, h5, h6) {
  letter-spacing: -0.015em;
  margin-top: 4.4rem;
  margin-bottom: 1.2rem;
  scroll-margin-top: 2rem;
}

article > header + :is(h2, h3, h4, h5, h6),
article > header + p + :is(h2, h3, h4, h5, h6) {
  margin-top: 3rem;
}

h4, h5, h6 {
  line-height: 1.3;
  font-weight: 700;
  margin-top: 3rem;
  margin-bottom: 1rem;
}

h4 {
  font-size: 1.7rem;
}

h5 {
  font-size: 1.6rem;
}

article h6,
h6 {
  font-size: 1.3rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--prose-muted);
}

article :is(ul, ol) {
  padding-left: 1.5em;
  margin-top: 0;
  margin-bottom: 2.5rem;
}

article li {
  margin-bottom: 0.6em;
  padding-left: 0.2em;
}

article li::marker {
  color: var(--prose-muted);
}

article ol > li::marker {
  font-variant-numeric: tabular-nums;
}

article li > :is(ul, ol) {
  margin-top: 0.6em;
  margin-bottom: 0;
}

article li > p {
  margin-bottom: 0.6em;
}

article ol ol {
  list-style-type: lower-alpha;
}

article ol ol ol {
  list-style-type: lower-roman;
}

article blockquote:not(.twitter-tweet) {
  margin: 4rem 0;
  padding: 0.2rem 0 0.2rem 2rem;
  border-left: 2px solid var(--prose-rule);
  font-family: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-size: 2.1rem;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: -0.015em;
  color: var(--prose-strong);
}

article blockquote:not(.twitter-tweet) p + p {
  margin-top: 1.2rem;
}

article blockquote:not(.twitter-tweet) blockquote {
  margin: 1.6rem 0;
  font-size: 1.8rem;
  color: inherit;
}

article blockquote > p:last-child > cite:last-child {
  display: block;
  margin-top: 1.4rem;
}

article blockquote cite {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-size: 1.5rem;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.4;
  color: var(--prose-muted);
}

article figure {
  margin-top: 3.6rem;
  margin-bottom: 3.6rem;
}

article figure img,
article figure video {
  border-radius: 1.2rem;
  margin-bottom: 0;
}

article figcaption {
  margin: 1.2rem auto 0;
  max-width: 56ch;
  font-size: 1.4rem;
  line-height: 1.45;
  color: var(--prose-muted);
}

hr {
  height: 0;
  margin: 5rem 0;
  border: 0;
  border-top: 1px solid var(--prose-hairline);
}

table {
  display: block;
  width: max-content;
  max-width: 100%;
  overflow-x: auto;
  margin: 0 auto 3rem;
  border-collapse: collapse;
  font-size: 1.6rem;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
}

th,
td {
  padding: 1rem 2.4rem 1rem 0;
  border-bottom: 1px solid var(--prose-hairline);
  text-align: left;
  vertical-align: top;
}

th:last-child,
td:last-child {
  padding-right: 0;
}

@media (max-width: 684px) {
  th,
  td {
    padding-right: 1.6rem;
    white-space: nowrap;
  }
}

th {
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--prose-muted);
  border-bottom-color: var(--prose-rule);
  white-space: nowrap;
}

caption {
  caption-side: bottom;
  padding-top: 1.2rem;
  font-size: 1.4rem;
  text-align: left;
  color: var(--prose-muted);
}

kbd {
  display: inline-block;
  min-width: 1.4em;
  padding: 0.05em 0.45em;
  font-size: 0.78em;
  line-height: 1.5;
  text-align: center;
  color: var(--prose-strong);
  background-color: var(--prose-raised);
  border: 1px solid var(--prose-rule);
  border-bottom-width: 2px;
  border-radius: 0.5rem;
  vertical-align: 0.1em;
}

mark {
  padding: 0.05em 0.1em;
  border-radius: 0.3rem;
  color: var(--prose-mark-text);
  background-color: var(--prose-mark);
}

abbr[title] {
  text-decoration: underline dotted;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.22em;
  cursor: help;
}

sub,
sup {
  position: relative;
  font-size: 0.72em;
  line-height: 0;
  vertical-align: baseline;
}

sup {
  top: -0.5em;
}

sub {
  bottom: -0.25em;
}

del {
  color: var(--prose-muted);
  text-decoration-thickness: 1px;
}

ins {
  padding: 0.05em 0.1em;
  border-radius: 0.3rem;
  text-decoration: none;
  background-color: var(--prose-ins);
}

details {
  margin: 0 0 2.5rem;
  border-top: 1px solid var(--prose-hairline);
  border-bottom: 1px solid var(--prose-hairline);
}

details + details {
  margin-top: -2.5rem;
  border-top: 0;
}

summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.6rem;
  min-height: 4.4rem;
  padding: 0.8rem 0;
  font-weight: 600;
  color: var(--prose-strong);
  cursor: pointer;
  list-style: none;
}

summary::-webkit-details-marker {
  display: none;
}

summary::after {
  content: "";
  flex: none;
  width: 0.5em;
  height: 0.5em;
  margin-right: 0.3em;
  border-right: 2px solid var(--prose-muted);
  border-bottom: 2px solid var(--prose-muted);
  transform: translateY(-0.15em) rotate(45deg);
  transition: transform 0.2s ease;
}

details[open] > summary::after {
  transform: translateY(0.15em) rotate(-135deg);
}

details > :last-child {
  margin-bottom: 1.6rem;
}

dl {
  margin: 0 0 2.5rem;
}

dt {
  font-weight: 700;
  color: var(--prose-strong);
}

dd {
  margin: 0.2rem 0 1.6rem;
  padding-left: 1.6rem;
  border-left: 1px solid var(--prose-hairline);
}

dd:last-child {
  margin-bottom: 0;
}

/* Site footer: one row of links, bullets drawn in CSS and kept off line starts */
body > footer nav ul {
  font-size: 0.9em;
  list-style: none;
  padding-left: 0;
  margin-bottom: 1.5rem;
}

body > footer nav li {
  display: inline;
  white-space: nowrap;
}

body > footer nav li:not(:last-child)::after {
  content: "\2022";
  content: "\2022" / "";
  margin-left: 0.3em;
}

body > footer p {
  margin-bottom: 1rem;
}

/* Apple HIG: color scheme, safe areas, motion, contrast and hit targets */
html {
  color-scheme: light dark;
  accent-color: #0065e6;
}

body {
  padding-top: max(1.3rem, env(safe-area-inset-top));
  padding-right: max(1.3rem, env(safe-area-inset-right));
  padding-bottom: max(1.3rem, env(safe-area-inset-bottom));
  padding-left: max(1.3rem, env(safe-area-inset-left));
}

/* Dark palette from sakura-dark.css v1.5.1; accent is the Extension.js docs
   theme (docs.json colors: primary #0065e6, light #60a5fa) */
@media (prefers-color-scheme: dark) {
  :root {
    --prose-strong: #f5f5f7;
    --prose-muted: #a1a1a6;
    --prose-hairline: #3a3a3c;
    --prose-rule: #545458;
    --prose-tint: #333336;
    --prose-code: #2c2c2e;
    --prose-raised: #2c2c2e;
    --prose-mark: #4d4419;
    --prose-mark-text: #f5f5f7;
    --prose-ins: #1f3d2a;
  }
  html {
    accent-color: #60a5fa;
  }
  body {
    color: #c9c9c9;
    background-color: #222222;
  }
  a, a:visited {
    color: #60a5fa;
  }
  a:hover {
    color: #93c5fd;
  }
  pre, pre span {
    color: var(--shiki-dark) !important;
  }
  button {
    background-color: #60a5fa;
    color: #222222;
    border-color: #60a5fa;
  }
  button:hover {
    background-color: #93c5fd;
    border-color: #93c5fd;
    color: #222222;
  }
  :focus-visible {
    outline-color: #60a5fa;
  }
  body > a[href="#main-content"]:focus {
    background-color: #222222;
  }
  a.badge,
  a.badge:visited {
    color: #c9c9c9;
    background-color: #4a4a4a;
  }
  a.badge:hover {
    color: #93c5fd;
  }
  body > header > :first-child + p img[src*="extension-dev"],
  article > footer p > a img[src*="/x-"] {
    border-radius: 0.2em;
    box-shadow: 0 0 0 1px #4a4a4a;
  }
}

@media (prefers-contrast: more) {
  body {
    color: #222222;
  }
  a {
    color: #004fb4;
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  :root {
    --prose-muted: #4a4a4a;
    --prose-rule: #8e8e93;
  }
  button {
    background-color: #004fb4;
    border-color: #004fb4;
  }
  :focus-visible {
    outline-width: 3px;
  }
}

@media (prefers-contrast: more) and (prefers-color-scheme: dark) {
  body {
    color: #ffffff;
  }
  :root {
    --prose-muted: #d1d1d6;
    --prose-rule: #8e8e93;
  }
  a, a:visited {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }
  button {
    background-color: #ffffff;
    border-color: #ffffff;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

@media (pointer: coarse) {
  button {
    min-height: 4.4rem;
    min-width: 4.4rem;
  }
  main li > a:first-child:not(.badge),
  main li > a.badge + a {
    padding-block: 1.2rem;
  }
  main li > a.badge::after {
    content: "";
    position: absolute;
    inset: -1.2rem -0.4rem;
  }
  main li {
    margin-bottom: 0.8em;
  }
  body > footer nav a,
  article > header nav a,
  h2 a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.4rem;
    min-width: 4.4rem;
  }
}
