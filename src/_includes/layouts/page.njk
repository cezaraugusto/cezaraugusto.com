{% extends 'layouts/default.njk' %} {% block main %}
<main id="main-content" tabindex="-1">
  <article>
    <header>
      <nav aria-label="Back"><a href="/" aria-label="Back to Home">← Home</a></nav>
      <h1>{{ title }}</h1>
    </header>
    {% if description %}
    <p>{{ description | markdownify_inline | safe }}</p>
    {% endif %}
    {% block lead %}{% endblock %}
    {% if image -%}
    <figure>
      <img src="{{ image }}" alt="{{ alt or '' }}"{% if imageWidth %} width="{{ imageWidth }}" height="{{ imageHeight }}"{% endif %} loading="eager">
      {% if caption -%}
      <figcaption>{{caption}}</figcaption>
      {%- endif %}
    </figure>
    {%- endif %}
    {% if page.inputPath.endsWith(".md") %}{{ content | safe }}{% else %}{{ content | markdownify | safe }}{% endif %}
  </article>
</main>
{% endblock %}
