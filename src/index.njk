heading: true
permalink: /index.html
updated: 2026-11-25
---

{% extends 'layouts/default.njk' %} {% block main %}
<main id="main-content" tabindex="-1">
  <section>
    <h2>Now</h2>
    <p>{{ site.now.text | markdownify_inline | safe }} <small>Updated <time datetime="{{ site.now.date }}">{{ site.now.date | date_month_year }}</time></small></p>
  </section>
  <section>
    {% set posts = collections.latestPosts %}
    <h2>Posts{% if collections.posts.length > posts.length %} <small>(<a href="/blog/" aria-label="{{ collections.posts.length | thousands }} · view all posts">{{ collections.posts.length | thousands }} · view all</a>)</small>{% endif %}</h2>
    {% include "components/post-list.njk" %}
  </section>
  <section>
    {% set allProjects = projects %}
    {% set projects = allProjects | pick_projects(site.homeProjects) %}
    <h2>Open-Source Projects{% if allProjects.length > projects.length %} <small>(<a href="/open-source/" aria-label="{{ allProjects.length | thousands }} · view all open-source projects">{{ allProjects.length | thousands }} · view all</a>)</small>{% endif %}</h2>
    {% include "components/project-list.njk" %}
  </section>
</main>
{% endblock %}
