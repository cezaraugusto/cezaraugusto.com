{
  "name": "cezaraugusto.com",
  "version": "1.0.0",
  "description": "Interwebs presence of Cezar Augusto",
  "scripts": {
    "dev": "cross-env NODE_ENV=staging eleventy --config=config/eleventy.config.mjs --serve",
    "build": "cross-env NODE_ENV=production eleventy --config=config/eleventy.config.mjs",
    "lint:js": "standard",
    "lint": "npm run lint:js",
    "format": "prettier --write \"**/*.{md,js,json,css,njk,html}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cezaraugusto/cezaraugusto.com"
  },
  "author": {
    "name": "Cezar Augusto",
    "email": "boss@cezaraugusto.net",
    "url": "https://cezaraugusto.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cezaraugusto/cezaraugusto.com/issues"
  },
  "homepage": "https://github.com/cezaraugusto/cezaraugusto.com",
  "standard": {
    "ignore": [
      "src/static/**"
    ]
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-fetch": "6.0.1",
    "@11ty/eleventy-img": "7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@fontsource/manrope": "5.3.0",
    "@shikijs/markdown-it": "4.6.0",
    "cross-env": "^10.1.0",
    "fast-xml-parser": "5.12.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "prettier": "^3.10.1",
    "standard": "^17.1.2"
  }
}
